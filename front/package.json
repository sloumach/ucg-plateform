{
  "name": "ucg-platform-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/vitest.xml",
    "test:e2e": "playwright test",
    "test:e2e:real": "node tests/real-api/run.mjs",
    "test:e2e:postgresql": "node tests/real-api/run.mjs --postgresql",
    "test:e2e:postgresql:harness": "node --test tests/real-api/postgresql.test.mjs",
    "test:e2e:harness": "node --test tests/real-api/environment.test.mjs",
    "test:load:smoke": "node tests/real-api/load-run.mjs --profile=smoke",
    "test:load:profile": "node tests/real-api/load-run.mjs --profile=profile",
    "test:load:volume": "node tests/real-api/load-run.mjs --profile=volume",
    "test:load:pressure": "node tests/real-api/load-run.mjs --profile=pressure",
    "test:load:harness": "node --test tests/real-api/load-protocol.test.mjs",
    "test:recovery:harness": "node --test tests/real-api/recovery-protocol.test.mjs",
    "test:recovery": "node --test tests/real-api/recovery.test.mjs",
    "test:recovery:tenant": "node --test tests/real-api/tenant-recovery.test.mjs",
    "test:recovery:graph": "node --test tests/real-api/tenant-graph.test.mjs",
    "test:recovery:pitr:harness": "node --test tests/real-api/pitr-protocol.test.mjs",
    "test:recovery:pitr": "node --test tests/real-api/pitr.test.mjs",
    "test:retention:harness": "node --test tests/real-api/retention-review.test.mjs",
    "test:retention:simulation": "node tests/real-api/retention-run.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "laravel-echo": "^2.6.1",
    "pusher-js": "^8.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
