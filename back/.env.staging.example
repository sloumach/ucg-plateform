APP_NAME="UCG staging"
CALENDAR_INVITATIONS_ENABLED=false
CALENDAR_CHANGES_ENABLED=false
REPORT_EXPORTS_ENABLED=false
EXPIRE_TENANT_ARTIFACTS_ENABLED=false
COMPETITION_REGISTRATION_REMINDERS_ENABLED=false
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.ucg-staging.example.invalid
FRONTEND_URL=https://app.ucg-staging.example.invalid

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres-staging.internal.invalid
DB_PORT=5432
DB_DATABASE=ucg_staging
DB_USERNAME=ucg_staging_app
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.ucg-staging.example.invalid
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=app.ucg-staging.example.invalid,api.ucg-staging.example.invalid
TENANCY_ALLOW_MULTIPLE_ORGANIZATIONS=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
ARTIFACTS_DISK=local
TENANCY_CACHE_STORE=redis
TENANCY_SCHEDULE_CONNECTION=redis
TENANCY_REQUESTS_PER_MINUTE=600
TENANCY_ARTIFACT_BYTES=26214400
TENANCY_STORAGE_BYTES=1073741824
TENANCY_IMPORT_BYTES=10485760
TENANCY_IMPORT_ROWS=10000
TENANCY_EXPORT_ROWS=50000
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis-staging.internal.invalid
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_RETRY_AFTER=330

HORIZON_NAME="UCG Platform"
HORIZON_AUTHORIZED_EMAILS=
HORIZON_METRICS_ENABLED=false

REVERB_APP_ID=ucg_staging
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.ucg-staging.example.invalid
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=app.ucg-staging.example.invalid
REVERB_SCALING_ENABLED=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Contract reminders: enable after migration; shared cache, scheduler and durable queue required.
CONTRACT_REMINDERS_ENABLED=false
CONTRACT_REMINDERS_EMAIL_ENABLED=false
CONTRACT_REMINDERS_MAILER=smtp
MAIL_TIMEOUT=5

# ClamAV: private clamd TCP endpoint; freshclam and daemon TZ=UTC required.
DOCUMENT_CLAMAV_ENABLED=false
DOCUMENT_CLAMAV_HOST=127.0.0.1
DOCUMENT_CLAMAV_PORT=3310
DOCUMENT_CLAMAV_CONNECT_SECONDS=3
DOCUMENT_CLAMAV_OPERATION_SECONDS=20
DOCUMENT_CLAMAV_MAX_DATABASE_AGE_SECONDS=604800

# Activate only after isolated statistical import acceptance checks.
STATISTICAL_IMPORT_PROCESSING_ENABLED=false

# Statistical calculations and targeted recalculation: enable after isolated acceptance.
STATISTICAL_CALCULATIONS_ENABLED=false

# REP-002: only enable after migration and reports worker verification.
DASHBOARD_INDICATORS_ENABLED=false

# Exemple uniquement : remplacer les domaines .invalid et injecter les secrets.
OPS_RESOURCE_NAMESPACE=ucg_staging
OPS_PUBLIC_DOMAIN=ucg-staging.example.invalid
OPS_SECRETS_SOURCE=runtime
OPS_DATA_CLASSIFICATION=synthetic
LARAVEL_STORAGE_PATH=/srv/ucg_staging/storage
SESSION_COOKIE=ucg_staging_session
SESSION_CONNECTION=default
CACHE_PREFIX=ucg_staging_cache_
REDIS_PREFIX=ucg_staging_redis_
HORIZON_PREFIX=ucg_staging_horizon:
REVERB_SCALING_CHANNEL=ucg_staging_reverb
HORIZON_REDIS_CONNECTION=default
DB_SSLMODE=require
